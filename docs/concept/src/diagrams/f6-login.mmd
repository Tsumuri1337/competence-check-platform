flowchart TB
  A@{ shape: stadium, label: "Начало" }
  B@{ shape: sl-rect, label: "Ввод email и пароля" }
  C@{ shape: diam, label: "Превышен лимит\nнеудачных попыток?" }
  D@{ shape: lean-r, label: "Отказ 429:\nповторить через 15 мин" }
  E["Проверка пароля\n(scrypt, сравнение за постоянное время)"]
  F@{ shape: diam, label: "Пароль\nверный?" }
  G[Счётчик неудач + 1] 
  H[Создание сессии:\nслучайный токен → httpOnly-кука,\nв БД — только sha256]
  I@{ shape: cyl, label: "Загрузка ролей\nпользователя" }
  J@{ shape: diam, label: "Ролей\nбольше одной?" }
  K@{ shape: sl-rect, label: "Выбор активной роли" }
  L["Построение меню по роли:\nтолько разрешённые вкладки,\nбейдж «Вы вошли как …»"]
  Z@{ shape: stadium, label: "Конец" }
  A --> B --> C
  C -- да --> D --> Z
  C -- нет --> E --> F
  F -- нет --> G --> B
  F -- да --> H --> I --> J
  J -- да --> K --> L
  J -- нет --> L
  L --> Z
