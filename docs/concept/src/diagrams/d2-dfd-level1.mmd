flowchart TB
  classDef ent fill:#f3f1ec,stroke:#1b2430,stroke-width:2px
  classDef proc fill:#ffffff,stroke:#1b2430,stroke-width:1.5px
  M[Методист]:::ent
  K[Кандидат / сотрудник]:::ent
  EX["Credly,<br/>ИБ-платформы"]:::ent
  P1(["1. Вести банк задач<br/>и требований"]):::proc
  P2(["2. Зарегистрировать,<br/>проверить сертификаты"]):::proc
  D1@{ shape: bow-rect, label: "D1 Требования и задачи" }
  D2@{ shape: bow-rect, label: "D2 Люди и сертификаты" }
  P3(["3. Провести проверку"]):::proc
  D3@{ shape: bow-rect, label: "D3 Проверки и ответы" }
  P4(["4. Оценить результаты"]):::proc
  R[Ревьюер]:::ent
  D4@{ shape: bow-rect, label: "D4 Оценки и резюме" }
  P5(["5. Сформировать аналитику"]):::proc
  A[Аналитик ОЦК]:::ent
  M -- "задачи, рубрики" --> P1
  K -- "данные, сертификаты" --> P2
  P2 -- "запросы" --> EX
  EX -- "профили, бейджи" --> P2
  P1 --> D1
  P2 --> D2
  D1 -- "выборка задач" --> P3
  K -- "ответы" --> P3
  P3 --> D3
  D3 --> P4
  D2 -- "подтверждённые<br/>сертификаты" --> P4
  R -- "оценки кейсов" --> P4
  P4 -- "отчёт" --> R
  P4 --> D4
  D4 -- "агрегаты" --> P5
  P5 -- "тепловая карта,<br/>дефицит" --> A
