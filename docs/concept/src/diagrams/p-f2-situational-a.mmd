flowchart TB
  A@{ shape: stadium, label: "Начало" }
  B@{ shape: doc, label: "Вывод сценария и материалов:\nлог, схема сети, конфигурация" }
  C["i := 1;  балл задачи := 0"]
  D@{ shape: notch-pent, label: "Цикл: шаг i из N" }
  E@{ shape: lean-r, label: "Вывод условия шага i\n(тип: выбор / порядок /\nпоиск ошибки / текст)" }
  F@{ shape: sl-rect, label: "Ввод ответа кандидата,\nфиксация времени" }
  G@{ shape: diam, label: "Тип шага —\nразвёрнутый текст?" }
  H[Автопроверка по ключу\nи рубрике шага]
  I[Пометка: требуется\nоценка ревьюера]
  X1@{ shape: circle, label: "1" }
  A --> B --> C --> D --> E --> F --> G
  G -- да --> I --> X1
  G -- нет --> H --> X1
