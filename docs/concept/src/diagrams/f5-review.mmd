flowchart TB
  A@{ shape: stadium, label: "Начало" }
  B@{ shape: lean-r, label: "Вывод карточки кандидата:\nоценка, темы, сертификаты, ответы" }
  C@{ shape: diam, label: "Нужно\nAI-резюме?" }
  D@{ shape: diam, label: "Настроен\nключ API?" }
  E@{ shape: fr-rect, label: "Запрос к модели\n(обезличенные данные)" }
  F[Копирование обезличенного\nзапроса в чат-ассистент]
  G@{ shape: sl-rect, label: "Вставка ответа\nассистента" }
  H@{ shape: diam, label: "Ответ соответствует\nсхеме?" }
  I@{ shape: lean-r, label: "Сообщение: какое\nполе неверно" }
  J@{ shape: cyl, label: "Сохранение AI-резюме" }
  K@{ shape: sl-rect, label: "Оценка кейс-заданий\nпо рубрике (0–100)" }
  L@{ shape: sl-rect, label: "Подтверждение / отклонение\nсертификатов «ручная проверка»" }
  M@{ shape: fr-rect, label: "Пересчёт итоговой\nоценки" }
  N@{ shape: diam, label: "Контекст —\nкандидат?" }
  O@{ shape: sl-rect, label: "Решение: принять /\nотклонить / рассмотреть" }
  P@{ shape: doc, label: "Комплексный отчёт\n(PDF)" }
  Z@{ shape: stadium, label: "Конец" }
  A --> B --> C
  C -- нет --> K
  C -- да --> D
  D -- да --> E --> J
  D -- нет --> F --> G --> H
  H -- нет --> I --> G
  H -- да --> J
  J --> K --> L --> M --> N
  N -- да --> O --> P
  N -- нет --> P
  P --> Z
