flowchart TB
  G@{ shape: diam, label: "Кейс оценён\nревьюером?" }
  H["Практика (до 35):\n35 · средняя оценка / 100"]
  I@{ shape: diam, label: "Есть AI-оценка\nполноты?" }
  J["Практика по AI-оценке;\nпризнак «предварительно»"]
  K["Компонент «Практика» исключается;\nпризнак «предварительно»"]
  L["Сертификаты (до 15):\nmin(15, Σ уровень · (0,25 + 0,75 · релевантность))"]
  M["Итог := round(100 · Σ баллов / Σ максимумов\nвключённых компонентов)"]
  N[Определение уровня:\n80+ эксперт … ниже 35 — недостаточно]
  O@{ shape: doc, label: "Итоговая оценка 0–100\nс разложением и флагами" }
  Z@{ shape: stadium, label: "Конец" }
  X1@{ shape: circle, label: "1" }
  X1 --> G
  G -- да --> H --> L
  G -- нет --> I
  I -- да --> J --> L
  I -- нет --> K --> L
  L --> M --> N --> O --> Z
